# ---- Supabase (browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Supabase (server / service role — NEVER expose to the browser) ----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Razorpay (Standard Checkout; Route optional) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Public key id used by the browser checkout widget (same value as KEY_ID,
# safe to expose — the SECRET must NEVER be prefixed with NEXT_PUBLIC_).
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
# Optional: dedicated admin linked account that receives platform commission
# (acc_XXXX). Only when set (and every vendor has a linked account) are Route
# split transfers attached; otherwise a standard order is created.
RAZORPAY_ADMIN_ACCOUNT_ID=

# Fallback commission % when a product row has no commission_pct (default 15).
DEFAULT_COMMISSION_PCT=15

# ---- Shiprocket (shipping; server only) ----
# Create an API user in Shiprocket: Settings → API → Create an API User.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Shared secret for the status webhook. Set the SAME value in Shiprocket:
# Settings → API → Webhooks → URL https://nutraatoz.com/api/shiprocket/webhook,
# Token = this value (Shiprocket sends it back as the `x-api-key` header).
SHIPROCKET_WEBHOOK_TOKEN=

# ---- Marketing / analytics (public; browser) ----
# Leave blank to disable a given tag. IDs only — never secrets.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=

# ---- Vendor dashboard ----
# Until Supabase Auth is wired, the dashboard scopes queries to this vendor.
# Set it to an id from your `vendors` table (or set a `vendor_id` cookie).
DEMO_VENDOR_ID=

# ---- Transactional email (server only) ----
# Vendor activation links are emailed to the vendor's registered address.
# Two backends are supported; set ONE. SMTP is preferred (sends from your own
# address). If neither is set, the admin can still copy the link to share.

# Option A — SMTP (e.g. Gmail). Sends FROM your own address.
#   For Gmail: enable 2-Step Verification, then create an App Password
#   (Google Account → Security → App passwords) and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=nutraatoz@gmail.com
SMTP_PASS=
EMAIL_FROM=Nutraatoz <nutraatoz@gmail.com>

# Option B — Resend HTTP API (needs a verified sending domain).
RESEND_API_KEY=
