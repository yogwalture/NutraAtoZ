# ---- Supabase (browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Supabase (server / service role — NEVER expose to the browser) ----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Razorpay Route ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Dedicated admin linked account that receives platform commission (acc_XXXX).
# Leave blank to let the primary account retain commission implicitly.
RAZORPAY_ADMIN_ACCOUNT_ID=acc_xxxxxxxxxxxxx

# Fallback commission % when a product row has no commission_pct (default 15).
DEFAULT_COMMISSION_PCT=15

# ---- Vendor dashboard ----
# Until Supabase Auth is wired, the dashboard scopes queries to this vendor.
# Set it to an id from your `vendors` table (or set a `vendor_id` cookie).
DEMO_VENDOR_ID=
